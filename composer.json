{
  "name": "firefly/laravel-audiosalad",
  "description": "AudioSalad API Client for Laravel",
  "keywords": [
    "laravel",
    "audiosalad",
    "api"
  ],
  "license": "MIT",
  "type": "project",
  "require": {
    "php": "^8",
    "ext-json": "*",
    "illuminate/console": ">=6",
    "illuminate/support": ">=6"
  },
  "autoload": {
    "psr-4": {
      "Firefly\\AudioSalad\\": "src/"
    }
  },
  "authors": [
    {
      "name": "Örjan Classon",
      "email": "orjan@hellofirefly.com"
    }
  ],
  "extra": {
    "laravel": {
      "providers": [
        "Firefly\\AudioSalad\\AudioSaladServiceProvider"
      ],
      "aliases": {
        "AudioSalad": "Firefly\\AudioSalad\\Facades\\AudioSalad"
      }
    }
  }
}
